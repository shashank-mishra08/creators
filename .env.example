# Copy to .env and point at any PostgreSQL instance
# (local, Docker, Supabase, Neon, Prisma Postgres, RDS, …)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/creators_home?schema=public"

# Secret used to sign auth session cookies. Set a long random value in production
# (e.g. `openssl rand -base64 32`). A dev fallback is used if unset.
AUTH_SECRET="change-me-to-a-long-random-string"

# ── Email (Resend) ──────────────────────────────────────────────────────────
# Needed to actually SEND invite / password-reset / lead-notification emails.
# Without RESEND_API_KEY the app still works — it just logs the link to the
# server console instead of emailing it, and the admin UI shows a copyable link.
#   1) Sign up free at https://resend.com and create an API key.
#   2) Put the key below.
#   3) EMAIL_FROM must be a sender Resend allows. For quick testing you can use
#      "onboarding@resend.dev" (only delivers to your own Resend account email).
#      To email anyone, verify your domain in Resend and use e.g.
#      "Creators <no-reply@yourdomain.com>".
RESEND_API_KEY=""
EMAIL_FROM="Creators Arena <onboarding@resend.dev>"

# ── Image storage (Cloudinary) ──────────────────────────────────────────────
# Needed for admin image uploads to work anywhere other than the machine that
# received them. Without these the upload route falls back to writing into
# public/properties/ — the file then 404s for every other developer and is
# wiped on the next deploy.
#   1) Create a free account at https://cloudinary.com
#   2) Dashboard → "Product Environment Credentials" → copy the three values.
# CLOUDINARY_API_SECRET is server-only; never expose it to the browser.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Folder inside the Cloudinary account. Optional, defaults to "properties".
CLOUDINARY_FOLDER="properties"
